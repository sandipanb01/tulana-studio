          "order": 18,
          "label": "Equation",
          "type": "Equation",
          "bbox_xyxy": [
            120.0,
            1680.2,
            911.7,
            1732.6
          ],
          "conf": 0.786,
          "text": "Thus $(x+2)^6 = x^6 + 12x^5 + 60x^4 + 160x^3 + 240x^2 + 192x + 64.$"
        }
